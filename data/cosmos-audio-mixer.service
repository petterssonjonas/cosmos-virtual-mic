# Managed by the Cosmos Audio Mixer per-user installer.
[Unit]
Description=Cosmos Audio Mixer engine
StartLimitIntervalSec=30
StartLimitBurst=3

[Service]
Type=simple
ExecStart=@EXEC_START@
Environment=@ENVIRONMENT@
Restart=on-failure
RestartSec=2
KillSignal=SIGTERM
TimeoutStopSec=15
UMask=0077

[Install]
WantedBy=default.target
